# ════════════════════════════════════════════════════════════════
# BOT V2.0 - CONFIGURACIÓN DE CREDENCIALES (TEMPLATE)
# ════════════════════════════════════════════════════════════════
#
# NOTA:
# - Para ejecutar el Modo Demo (--mode demo) o el Motor de Backtesting
#   NO es necesario crear un archivo .env ni tener claves de API.
# - Para operar conectado a Ripio / Telegram:
#   1. Copia este archivo a .env
#   2. Reemplaza los valores con tus credenciales reales
#   3. NUNCA subas .env a Git
#
# ════════════════════════════════════════════════════════════════

# TELEGRAM BOT (Control Remoto Opcional)
# Obtén el token de @BotFather y tu User ID de @userinfobot
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_AUTHORIZED_USERS=123456789

# RIPIO TRADE API v4
RIPIO_API_TOKEN=tu_ripio_api_token_aqui
RIPIO_SECRET_KEY=tu_ripio_secret_key_aqui

# MODO DE OPERACIÓN
# Valores: demo, paper_trading, live_trading
TRADING_MODE=paper_trading

# CAPITAL INICIAL (USD)
CAPITAL_INICIAL=1000

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=data/logs/bot.log
